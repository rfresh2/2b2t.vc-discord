{
  "openapi": "3.1.0",
  "info": {
    "description": "2b2t Data And Statistics API\n\nDiscord Bot Invite: https://bot.2b2t.vc\n\nQueue Dashboard: https://q.2b2t.vc\n\nSupport & API Keys: https://discord.gg/nJZrSaRKtb\n\nSource Code:\n\nAPI: https://github.com/rfresh2/2b2t.vc-api\n\nDiscord Bot: https://github.com/rfresh2/2b2t.vc-discord\n\nIn-game Bots: https://github.com/rfresh2/ZenithProxy\n",
    "title": "2b2t.vc API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.2b2t.vc"
    }
  ],
  "paths": {
    "/bots/month": {
      "get": {
        "operationId": "onlinePlayers_1",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BotsMonthResponse"
                }
              }
            },
            "description": "List of suspected bots over the past 30 days.\n\nCalculated based on number of times a player has been online for at least the max non-prio session time limit.\n\nData is refreshed daily, but the heuristics search over the past 30 days.\n"
          },
          "204": {
            "description": "No data"
          }
        },
        "tags": [
          "Bots"
        ]
      }
    },
    "/chats": {
      "get": {
        "operationId": "chats",
        "parameters": [
          {
            "description": "Filter only chats that contain this word",
            "in": "query",
            "name": "word",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Resolves to current UUID",
            "in": "query",
            "name": "playerName",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "uuid",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "startDate",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "in": "query",
            "name": "endDate",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "description": "Must be between 1-100",
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "description": "Response page",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatSearchResponse"
                }
              }
            },
            "description": "Search for chat messages with optional filters"
          },
          "204": {
            "description": "No data"
          },
          "400": {
            "description": "Bad request.\n\nIf word is provided, it must be between 3 and 50 valid chat characters.\n\nIf uuid or playerName is provided, it must be for a valid and existing account.\n\nEither word or player must be provided.\n\nIf pageSize is provided, it must be between 1 and 100.\n\nIf startDate and endDate are provided, they must be valid dates in ISO 8601 format, example: \"2022-10-31\".\n"
          }
        },
        "tags": [
          "Chats"
        ]
      }
    },
    "/chats/window": {
      "get": {
        "operationId": "chatWindow",
        "parameters": [
          {
            "in": "query",
            "name": "startDate",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "in": "query",
            "name": "endDate",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "description": "Must be between 1-100",
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "description": "Response page",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatWindowResponse"
                }
              }
            },
            "description": "All 2b2t chats during a window of time, starting from startDate until endDate or pageSize is met.\n\nResults are sorted in ascending order by default.\n\nstartDate is required if sort is ASC, endDate is required if sort is DESC.\n\nstartDate and endDate must be ISO 8601 formatted strings, in this format: yyyy-MM-dd'T'HH:mm:ss.SSSXXX\n\nExample: \"2022-10-31T01:30:00.000\".\n"
          },
          "204": {
            "description": "No chats found in this window."
          },
          "400": {
            "description": "Bad request. startDate must be provided"
          }
        },
        "tags": [
          "Chats"
        ]
      }
    },
